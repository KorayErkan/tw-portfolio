digraph G {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.8, ranksep=0.8, fontname="Calibri", fontsize=14];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.9, penwidth=2, fontname="Calibri", fontsize=13];

  subgraph cluster_customer {
    label="Customer network";
    style="rounded,filled"; fillcolor="#f0fff0";
    sources [label="Internal systems\n(file shares, object stores)", fillcolor="#dcedc8"];
    agent [label="Orbitask agent 1.8.0\n(systemd service)", fillcolor="#c8e6c9"];
    firewall [label="Firewall / proxy\n(egress on 443 only)", fillcolor="#fff3e0"];
    security_note [label="No inbound ports\nEnrollment token, then\nper-agent credentials\nTLS 1.2+", fillcolor="#f5f5f5", shape=note];
    { rank=same; sources; agent; security_note; }
  }

  subgraph cluster_cloud {
    label="Orbitask cloud";
    style="rounded,filled"; fillcolor="#f0f8ff";
    ingress [label="Agent ingress\nagent.orbitask.example:443", fillcolor="#bbdefb"];
    control [label="Connector service\n(jobs and configuration)", fillcolor="#bbdefb"];
    telemetry [label="Health and logs\n(Admin → Connectors)", fillcolor="#bbdefb"];
  }

  agent -> sources [label="reads", style=dashed];
  agent -> firewall [label="HTTPS"];
  firewall -> ingress [label="outbound only"];
  ingress -> control [label="jobs, config"];
  ingress -> telemetry [label="heartbeat, logs"];
  security_note -> agent [style=dotted, arrowhead=none];

}
