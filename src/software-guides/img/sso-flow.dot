digraph G {
  graph [rankdir=TB, splines=false, bgcolor="transparent", nodesep=1.2, ranksep=0.8];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.8, penwidth=1.5, fontname="Calibri", fontsize=14];

  // Actors at the top
  user [label="User", fillcolor="#e3f2fd", shape=ellipse];
  app [label="CloudFlow App", fillcolor="#fff3e0"];
  idp [label="Identity Provider\n(SAML/OIDC)", fillcolor="#e8f5e9"];

  // Sequence steps - top to bottom
  step1 [label="1. Login Request", fillcolor="#f0f0f0", shape=note];
  step2 [label="2. Redirect to IdP", fillcolor="#f0f0f0", shape=note];
  step3 [label="3. User Authentication\n(Username/Password + MFA)", fillcolor="#f0f0f0", shape=note];
  step4 [label="4. SAML/OIDC Response", fillcolor="#f0f0f0", shape=note];
  step5 [label="5. Token Validation", fillcolor="#f0f0f0", shape=note];
  step6 [label="6. Session Created", fillcolor="#c8e6c9", shape=note];

  // Flow connections
  user -> step1;
  step1 -> app;
  app -> step2;
  step2 -> idp;
  idp -> step3;
  step3 -> user;
  user -> step4;
  step4 -> app;
  app -> step5;
  step5 -> idp;
  idp -> step6;
  step6 -> app;

  // Result
  success [label="✓ Authenticated Session\nUser can access application",
           fillcolor="#c8e6c9", shape=ellipse];
  step6 -> success;
}
