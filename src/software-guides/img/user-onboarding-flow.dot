digraph G {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.9, ranksep=0.6, fontname="Calibri", fontsize=13,
         labelloc=b, label="Typical time: 5–10 minutes"];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14, width=2.0];
  edge [arrowsize=0.9, penwidth=2, fontname="Calibri", fontsize=13];

  start [label="Sign in", fillcolor="#e3f2fd", shape=ellipse];
  setup_project [label="Create first\nproject", fillcolor="#fff3e0"];
  team_decision [label="Working with\na team?", fillcolor="#f0f0f0", shape=diamond];
  invite_users [label="Invite\nteammates", fillcolor="#e8f5e9"];
  solo_setup [label="Set personal\npreferences", fillcolor="#e8f5e9"];
  complete_checklist [label="Finish the setup\nchecklist", fillcolor="#fff3e0"];
  ready [label="Ready to work", fillcolor="#c8e6c9", shape=ellipse];
  learn_features [label="Explore reports,\nintegrations (optional)", fillcolor="#f3e5f5", style="rounded,dashed,filled"];

  start -> setup_project -> team_decision;
  team_decision -> invite_users [label="Yes"];
  team_decision -> solo_setup [label="No"];
  invite_users -> complete_checklist;
  solo_setup -> complete_checklist;
  complete_checklist -> ready;
  ready -> learn_features [style=dashed, label="optional"];
}
