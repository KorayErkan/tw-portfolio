digraph G {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.9, ranksep=0.9, fontname="Calibri", fontsize=14];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.8, penwidth=1.5, fontname="Calibri", fontsize=13];

  // Event sources
  subgraph cluster_sources {
    label="Event sources (Orbitask services)";
    style="rounded,filled"; fillcolor="#f0f8ff";
    projects [label="Projects and\ntasks service", fillcolor="#bbdefb"];
    reports  [label="Reporting\nservice", fillcolor="#bbdefb"];
    identity [label="Identity\nservice", fillcolor="#bbdefb"];
  }

  // Delivery pipeline
  subgraph cluster_pipeline {
    label="Webhook pipeline";
    style="rounded,filled"; fillcolor="#f0fff0";
    eventbus  [label="Message queue\n(events)", fillcolor="#c8e6c9"];
    formatter [label="Formatter\n(JSON payload + event id)", fillcolor="#c8e6c9"];
    delivery  [label="Delivery service\n(signs with HMAC-SHA256)", fillcolor="#c8e6c9"];
    retry_queue [label="Retry queue\n(exponential backoff,\nup to 8 attempts / ~24 h)", fillcolor="#f3e5f5"];
    dead_letter [label="Failed deliveries\n(redeliver from Admin → Webhooks)", fillcolor="#ffebee"];
  }

  // Customer endpoints
  subgraph cluster_destinations {
    label="Customer endpoints";
    style="rounded,filled"; fillcolor="#fffaf0";
    endpoint1 [label="Endpoint A\nhooks.acme.example", fillcolor="#ffe0b2"];
    endpoint2 [label="Endpoint B\nintegrations.acme.example", fillcolor="#ffe0b2"];
  }

  monitoring [label="Delivery log and\nworkspace health", fillcolor="#eeeeee"];

  projects -> eventbus;
  reports  -> eventbus;
  identity -> eventbus;

  eventbus  -> formatter [label="events"];
  formatter -> delivery;

  delivery -> endpoint1 [label="HTTPS POST\nOrbitask-Signature"];
  delivery -> endpoint2 [label="HTTPS POST\nOrbitask-Signature"];

  // Error handling: failures go to the retry queue; the queue re-attempts delivery
  delivery    -> retry_queue [label="non-2xx or\ntimeout (10 s)", style=dashed, color="#c62828", fontcolor="#c62828"];
  retry_queue -> delivery    [label="retry\nattempt", style=dashed];
  retry_queue -> dead_letter [label="max attempts\nreached", style=dashed, color="#c62828", fontcolor="#c62828"];

  delivery    -> monitoring [label="result of\nevery attempt", style=dotted];
  dead_letter -> monitoring [style=dotted];
}
