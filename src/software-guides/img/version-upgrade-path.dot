digraph G {
  graph [rankdir=LR, bgcolor="transparent", nodesep=0.6, ranksep=0.9, fontname="Calibri", fontsize=14];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.9, penwidth=2, fontname="Calibri", fontsize=13];

  subgraph cluster_timeline {
    label="Orbitask releases";
    style="rounded,filled"; fillcolor="#fafafa";
    v16 [label="1.6.x\nsupport ends 2026-09-30", fillcolor="#ffebee"];
    v17 [label="1.7.0 / 1.7.2\nJune–July 2026", fillcolor="#fff3e0"];
    v18 [label="1.8.0 (current)\n2026-08-18", fillcolor="#e8f5e9", penwidth=2];
    v19 [label="1.9.0\nplanned Q2 2027", fillcolor="#e3f2fd", style="rounded,dashed,filled"];
  }

  subgraph cluster_api {
    label="API versions";
    style="rounded,filled"; fillcolor="#f9f5ff";
    api_v2 [label="API v2\ncurrent for all endpoints", fillcolor="#c8e6c9"];
    api_v1 [label="API v1\ndeprecated", fillcolor="#ffcdd2"];
    api_v1_eol [label="API v1 end of life\n2026-11-16\n(v1 calls return 410 Gone)", fillcolor="#ffebee", shape=note];
  }

  v16 -> v17;
  v17 -> v18;
  v18 -> v19 [style=dashed];

  v18 -> api_v1 [label="deprecates", style=dashed];
  v18 -> api_v2 [label="completes", style=dashed];
  api_v1 -> api_v1_eol [label="90 days"];
  api_v1 -> api_v2 [label="migrate", constraint=false];
}
