digraph G {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.8, ranksep=0.6, fontname="Calibri", fontsize=14];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14, width=3.2, height=0.7];
  edge [arrowsize=0.9, penwidth=1.8, fontname="Calibri", fontsize=13];

  external [label="Clients and users\n(browser, CLI, API, agent)", fillcolor="#e3f2fd"];

  subgraph cluster_network {
    label="Network layer (Orbitask edge)";
    style="rounded,filled"; fillcolor="#f0fff0";
    edge_waf [label="Edge / WAF\nTLS 1.2+ terminates here", fillcolor="#c8e6c9"];
    ratelimit [label="API gateway\nrate limiting (per token / IP)", fillcolor="#c8e6c9"];
  }

  subgraph cluster_application {
    label="Application layer";
    style="rounded,filled"; fillcolor="#fffaf0";
    authentication [label="Authentication\n(SSO + MFA, sessions, API tokens)", fillcolor="#ffe0b2"];
    authorization [label="Authorization\n(workspace roles, token scopes)", fillcolor="#ffe0b2"];
    services [label="Orbitask services", fillcolor="#ffe0b2"];
  }

  subgraph cluster_data {
    label="Data layer";
    style="rounded,filled"; fillcolor="#f9f5ff";
    storage [label="Database, cache snapshots,\nbackups, object storage\n(AES-256 at rest)", fillcolor="#e1bee7", shape=cylinder, height=1.1];
    keys [label="Key management\nservice (KMS)", fillcolor="#e1bee7"];
    { rank=same; storage; keys; }
  }

  external -> edge_waf [label="HTTPS (TLS 1.2+)"];
  edge_waf -> ratelimit [label="filtered request\n(re-encrypted internally)"];
  ratelimit -> authentication [label="within limits"];
  authentication -> authorization [label="identified user"];
  authorization -> services [label="allowed action"];
  services -> storage [label="encrypted read/write"];
  keys -> storage [label="data keys,\n12-month rotation", style=dashed];

}
