digraph G {
  graph [rankdir=TD, splines=false, bgcolor="transparent", nodesep=1.0, ranksep=1.5];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.9, penwidth=2, fontname="Calibri", fontsize=14];

  // Customer Side
  subgraph cluster_customer {
    label="Customer Network";
    style="rounded,filled";
    fillcolor="#f0fff0";
    fontname="Calibri";
    fontsize=14;
    agent [label="CloudFlow Agent\n(Service)", fillcolor="#c8e6c9"];
  }

  // Network Boundary
  firewall [label="Firewall/Proxy\n(Egress Only)", fillcolor="#fff3e0", shape=diamond];

  // Cloud Side
  subgraph cluster_cloud {
    label="SaaS Cloud Platform";
    style="rounded,filled";
    fillcolor="#f0f8ff";
    fontname="Calibri";
    fontsize=14;
    ingress [label="Agent Ingress\napi.cloudflow.com", fillcolor="#bbdefb"];
    control [label="Control Plane", fillcolor="#bbdefb"];
    telemetry [label="Telemetry", fillcolor="#bbdefb"];
  }

  // Simple left-to-right flow
  agent -> firewall [label="HTTPS/443"];
  firewall -> ingress [label="Outbound Only"];
  ingress -> control [label="Config/Tokens"];
  ingress -> telemetry [label="Health/Logs"];

  // Security notes
  security_note [label="✓ No Inbound Ports\n✓ Token Rotation\n✓ TLS 1.2+",
                fillcolor="#f0f0f0", shape=note];
}
