digraph G {
  graph [rankdir=TB, splines=false, bgcolor="transparent", nodesep=0.8, ranksep=1.2];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.8, penwidth=1.5, fontname="Calibri", fontsize=14];

  // Presentation Layer
  subgraph cluster_presentation {
    label="Presentation Layer";
    style="rounded,filled";
    fillcolor="#f0f8ff";
    fontname="Calibri";
    fontsize=14;
    webapp [label="Web Application", fillcolor="#bbdefb"];
    mobile [label="Mobile App", fillcolor="#bbdefb"];
    cli [label="CLI/SDK Tools", fillcolor="#bbdefb"];
  }

  // API Gateway Layer
  subgraph cluster_gateway {
    label="API Gateway";
    style="rounded,filled";
    fillcolor="#f0fff0";
    fontname="Calibri";
    fontsize=14;
    gateway [label="API Gateway\n(Routing & Auth)", fillcolor="#c8e6c9"];
  }

  // Business Services Layer
  subgraph cluster_services {
    label="Business Services";
    style="rounded,filled";
    fillcolor="#fffaf0";
    fontname="Calibri";
    fontsize=14;
    auth [label="Authentication\nService", fillcolor="#ffe0b2"];
    projects [label="Projects\nService", fillcolor="#ffe0b2"];
    reporting [label="Reporting\nService", fillcolor="#ffe0b2"];
    webhooks [label="Webhooks\nService", fillcolor="#ffe0b2"];
  }

  // Data Layer
  subgraph cluster_data {
    label="Data Layer";
    style="rounded,filled";
    fillcolor="#f9f5ff";
    fontname="Calibri";
    fontsize=14;
    database [label="Primary\nDatabase", fillcolor="#e1bee7", shape=cylinder];
    queues [label="Message\nQueues", fillcolor="#e1bee7", shape=component];
  }

  // Connections - Clean top-to-bottom flow
  webapp -> gateway;
  mobile -> gateway;
  cli -> gateway;

  gateway -> auth;
  gateway -> projects;
  gateway -> reporting;
  gateway -> webhooks;

  auth -> database;
  projects -> database;
  reporting -> database;
  reporting -> queues;
  webhooks -> queues;
}
