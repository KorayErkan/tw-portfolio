digraph G {
  graph [rankdir=LR, splines=false, bgcolor="transparent", nodesep=1.5, ranksep=1.0];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.9, penwidth=2, fontname="Calibri", fontsize=14];

  // Timeline - Software Versions
  subgraph cluster_timeline {
    label="Software Release Timeline";
    style="rounded,filled";
    fillcolor="#fafafa";
    fontname="Calibri";
    fontsize=14;

    v16 [label="v1.6.x\nLegacy", fillcolor="#ffebee"];
    v17 [label="v1.7.2\nSecurity Fixes", fillcolor="#fff3e0"];
    v18 [label="v1.8.0\nCurrent Stable", fillcolor="#e8f5e9"];
    v19 [label="v1.9.0\nPlanned (Q2)", fillcolor="#e3f2fd", style="rounded,dashed"];
  }

  // API Evolution
  subgraph cluster_api {
    label="API Versions";
    style="rounded,filled";
    fillcolor="#f9f5ff";
    fontname="Calibri";
    fontsize=14;

    api_v1 [label="API v1\nDeprecated", fillcolor="#ffcdd2"];
    api_v2 [label="API v2\nRecommended", fillcolor="#c8e6c9"];
  }

  // Upgrade path
  v16 -> v17 [label="Security\nPatches"];
  v17 -> v18 [label="Feature\nUpgrade"];
  v18 -> v19 [label="90 Days", style=dashed];

  // API migration
  api_v1 -> api_v2 [label="Migration\nRequired"];

  // Support timeline
  migration_note [label="⚠ API v1 End-of-Life:\n90 days from v1.9.0 release",
                  fillcolor="#fffaf0", shape=note];
}
