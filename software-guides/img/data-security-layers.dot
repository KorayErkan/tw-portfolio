digraph G {
  graph [rankdir=TB, splines=false, bgcolor="transparent", nodesep=2.0, ranksep=1.5];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14, width=2.5, height=0.8];
  edge [arrowsize=1.0, penwidth=2, fontname="Calibri", fontsize=14];

  // Security Layers - Top to Bottom

  // Layer 1: External Access
  external [label="Client Applications\n& External Users", fillcolor="#e3f2fd"];

  // Layer 2: Network Security
  subgraph cluster_network {
    label="Network Security Layer";
    style="rounded,filled";
    fillcolor="#f0fff0";
    fontname="Calibri";
    fontsize=14;

    tls [label="TLS 1.2+ Encryption\n(In Transit)", fillcolor="#c8e6c9"];
    firewall [label="Web Application\nFirewall (WAF)", fillcolor="#c8e6c9"];
  }

  // Layer 3: Application Security
  subgraph cluster_application {
    label="Application Security Layer";
    style="rounded,filled";
    fillcolor="#fffaf0";
    fontname="Calibri";
    fontsize=14;

    authentication [label="SSO/MFA\nAuthentication", fillcolor="#ffe0b2"];
    authorization [label="Role-Based Access\nControl (RBAC)", fillcolor="#ffe0b2"];
    gateway [label="API Gateway\n& Rate Limiting", fillcolor="#ffe0b2"];
  }

  // Layer 4: Data Security
  subgraph cluster_data {
    label="Data Security Layer";
    style="rounded,filled";
    fillcolor="#f9f5ff";
    fontname="Calibri";
    fontsize=14;

    encryption [label="AES-256 Encryption\n(At Rest)", fillcolor="#e1bee7"];
    keys [label="Key Management\nService (KMS)", fillcolor="#e1bee7"];
    database [label="Encrypted Database\nStorage", fillcolor="#e1bee7", shape=cylinder];
  }

  // Flow through security layers
  external -> tls [label="HTTPS Request"];
  tls -> firewall [label="Encrypted Traffic"];
  firewall -> authentication [label="Validated Request"];
  authentication -> authorization [label="Authenticated User"];
  authorization -> gateway [label="Authorized Access"];
  gateway -> encryption [label="API Call"];
  encryption -> database [label="Encrypted Data"];

  // Key management
  keys -> encryption [label="Key Rotation\n& Management", style=dashed];
}
