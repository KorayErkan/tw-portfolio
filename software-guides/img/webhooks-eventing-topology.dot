digraph G {
  graph [rankdir=TD, splines=false, bgcolor="transparent", nodesep=1.0, ranksep=1.2];
  node [shape=box, style="rounded,filled", fontname="Calibri", fontsize=14];
  edge [arrowsize=0.8, penwidth=1.5, fontname="Calibri", fontsize=14];

  // Event Sources
  subgraph cluster_sources {
    label="Event Sources";
    style="rounded,filled";
    fillcolor="#f0f8ff";
    fontname="Calibri";
    fontsize=14;
    projects [label="Projects\nService", fillcolor="#bbdefb"];
    reports [label="Reports\nService", fillcolor="#bbdefb"];
    auth [label="Auth\nService", fillcolor="#bbdefb"];
  }

  // Processing Pipeline
  subgraph cluster_pipeline {
    label="Webhook Pipeline";
    style="rounded,filled";
    fillcolor="#f0fff0";
    fontname="Calibri";
    fontsize=14;

    eventbus [label="Event Bus\n(Message Routing)", fillcolor="#c8e6c9"];
    formatter [label="Webhook\nFormatter", fillcolor="#c8e6c9"];
    delivery [label="Delivery\nService", fillcolor="#c8e6c9"];
  }

  // Destination
  subgraph cluster_destinations {
    label="Customer Endpoints";
    style="rounded,filled";
    fillcolor="#fffaf0";
    fontname="Calibri";
    fontsize=14;

    endpoint1 [label="Endpoint A\nhooks.example.com", fillcolor="#ffe0b2"];
    endpoint2 [label="Endpoint B\napi.customer.com", fillcolor="#ffe0b2"];
  }

  // Reliability Components
  retry_queue [label="Retry Queue\n(Exponential Backoff)", fillcolor="#f3e5f5"];
  dead_letter [label="Dead Letter\nQueue", fillcolor="#ffebee"];
  monitoring [label="Delivery\nMonitoring", fillcolor="#f0f0f0"];

  // Main flow
  projects -> eventbus;
  reports -> eventbus;
  auth -> eventbus;

  eventbus -> formatter [label="Events"];
  formatter -> delivery [label="JSON + HMAC"];

  delivery -> endpoint1 [label="HTTPS POST"];
  delivery -> endpoint2 [label="HTTPS POST"];

  // Error handling
  delivery -> retry_queue [headlabel="Retry Attempts", style=dashed];
  retry_queue -> delivery  [taillabel="Failed Deliveries", style=dashed];
  retry_queue -> dead_letter [label="Max Retries\nExceeded", style=dashed];

  // Monitoring
  delivery -> monitoring [label="Metrics"];
  retry_queue -> monitoring [label="Retry Stats"];
}